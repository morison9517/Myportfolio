# =============================================================================
# Dockerの箱に入れないもの(.gitignore とは別物)
#   目的1: .env を箱に焼き込まない(配布した相手にパスワードが渡るため)
#   目的2: 不要なファイルを渡さないほどビルドが速い
# =============================================================================

# --- 秘密のもの ---
.env
.env.local
*.pem
*.key

# --- Gitの管理データ(箱の中では不要。意外と大きい) ---
.git
.gitignore

# --- Goが作る成果物(箱の中で作り直すので不要) ---
tmp/
bin/
dist/
*.exe
*.test

# --- エディタ / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- ドキュメント(動作に不要) ---
docs/
README.md

# --- ログや一時ファイル ---
*.log
logs/
temp/
