# =============================================================================
# .env の見本(これはGitHubに上がる。.env 本体は上がらない)
#
#   初回だけ、これをコピーして .env を作る:
#     Windows: Copy-Item .env.example .env
#     Mac:     cp .env.example .env
#
#   ★項目を増やしたら、このファイルにも同じ項目を書き足すこと。
#     見本が古いと、他の人が起動できなくなる。
# =============================================================================

# --- アプリの設定 ---
# development = 開発用。エラーが詳しく出る + CSSや画像をGinが配る
# production  = 本番用。エラーの中身を隠す + CSSはNginxが配る
#
#   ★開発中に production にすると、HTMLの変更が即反映されなくなります。
#     本番では起動時に1回だけ読み込む作りだからです。
#
#   ★「保存したら作り直される」は air の機能で、この設定とは無関係です。
#     本番で反映されないのは、実行ファイルに固めて動かしているからです(docs/DEPLOY.md)。
APP_ENV=development

# --- ここから下は本番(compose.prod.yml)でだけ使う ---
#     開発中は書かなくて構いません。手順は docs/DEPLOY.md

# メモ(Cookie)を HTTPS のときだけ持ち歩く設定。本番は true のままにする。
# ★まだ HTTPS にしていないときだけ false にする。
#   true のまま http:// で開くと、メモが保存されずメッセージなどが消えます。
SECURE_COOKIES=true

# Nginxのアドレス範囲。ここに書いたところから来たヘッダーだけを信用する。
# ★空だと誰も信用しない(開発中はこれでよい)。
#   本番では Docker の内部ネットワークを指定する(手順は docs/DEPLOY.md)。
# 例: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# 利用者が上げたファイルの保存先。通常は変えなくてよい。
UPLOAD_DIR=media

# アプリが待ち受ける番号。compose.yml の "8080:8080" の右側と合わせる。
PORT=8080

# SECRET_KEY: ブラウザに預けるメモ(Cookie)に押す「割り印」。
#             漏れるとメモの中身を偽造されるので、本番では必ず変更する。
SECRET_KEY=please-change-this-to-a-long-random-string

# --- データベースの設定 ---
# DB_HOST: Dockerの中では compose.yml のサービス名 "db" がそのまま住所になる。
DB_HOST=db
DB_PORT=3306
DB_NAME=hack_app
DB_USER=hack_user
DB_PASSWORD=hack_password
DB_ROOT_PASSWORD=root_password
