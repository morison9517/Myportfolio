# =============================================================================
# アプリを動かす箱の作り方
#
#   上から順に実行される。Dockerは「前回と同じ工程は結果を再利用」するので、
#   変わりにくい作業(部品のインストール)を先に、よく変わる作業(コードの
#   コピー)を後に書く。こうすると2回目以降のビルドが数秒で終わる。
#
#   ▼ このファイルには箱が4つ書いてある(段階に分けている)
#       base  … 共通の土台
#       dev   … 開発用(★普段使うのはこれだけ)
#       build … 本番用にアプリを1個のファイルに固める工程
#       prod  … 本番用の完成品
#
#     compose.yml で target: dev と指定しているので、開発中は dev だけが作られる。
# =============================================================================

# -----------------------------------------------------------------------------
# base = 共通の土台
# -----------------------------------------------------------------------------
FROM golang:1.26-bookworm AS base

WORKDIR /app

# CGO_ENABLED=0 = Goだけで完結させる指定。
# これがあると、後で「OSに入っていない部品が無い」というエラーが起きなくなる。
ENV CGO_ENABLED=0 \
    TZ=Asia/Tokyo

# ★買い物リストだけ先にコピーする理由
#   全ファイルを先にコピーすると、HTMLを1文字直すたびに部品の再ダウンロードが
#   走る。リストだけ渡せば、リストが変わらない限り再ダウンロードは起きない。
COPY go.mod go.sum ./
RUN go mod download

# -----------------------------------------------------------------------------
# dev = 開発用の箱(compose.yml から使われるのはこれ)
# -----------------------------------------------------------------------------
FROM base AS dev

# air = コードを保存すると自動でビルドし直して再起動してくれる道具。
#
# ★Goは「書いたコードを実行前に機械語に翻訳する」言語なので、
#   本来はコードを直すたびに手で翻訳(ビルド)し直す必要がある。
#   airがそれを自動でやってくれるので、保存 → 数秒 → 反映 になる。
#
# ★latest にすると突然の更新でビルドが壊れるのでバージョンを固定する。
RUN go install github.com/air-verse/air@v1.67.4

# コピーしないものは .dockerignore に書いてある。
COPY . .

EXPOSE 8080

# 設定は .air.toml に書いてある。
CMD ["air", "-c", ".air.toml"]

# -----------------------------------------------------------------------------
# build = 本番用にアプリを1個のファイルに固める工程
# -----------------------------------------------------------------------------
FROM base AS build

COPY . .

# -ldflags="-s -w" = デバッグ情報を落としてファイルを小さくする。
RUN go build -ldflags="-s -w" -o /out/server ./cmd/server

# -----------------------------------------------------------------------------
# prod = 本番用の完成品(AWSに置くのはこれ)
#
#   ★Goの大きな利点
#     出来上がるのは「1個の実行ファイル」なので、本番の箱にGo本体を入れる
#     必要がない。上の dev の箱が1GB近いのに対し、こちらは20MB程度で済む。
#     起動も速く、AWSの費用も抑えられる。
# -----------------------------------------------------------------------------
FROM alpine:3.22 AS prod

# ca-certificates … 外部サイトへHTTPSで通信するために必要
# tzdata          … 日本時間を扱うために必要(無いとUTCになる)
RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Tokyo

WORKDIR /app

COPY --from=build /out/server /app/server

# HTMLとCSSは実行ファイルの外にあるので、別途コピーする。
COPY web ./web

EXPOSE 8080

CMD ["/app/server"]
